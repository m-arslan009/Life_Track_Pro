        "handler": "taskDetail",
        "purpose": "Update task",
        "auth": "Yes",
        "required": {
          "path": ["pk"]
        },
        "optional": {
          "body": ["title", "description", "status", "project", "milestone", "assignee"]
        }
      },
      {
        "path": "/api/milestones/milestones/",
        "method": "POST",
        "app": "milestones",
        "handler": "milestoneListCreate",
