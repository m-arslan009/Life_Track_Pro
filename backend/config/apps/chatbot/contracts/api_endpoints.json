        },
        "optional": {}
      },
      {
        "path": "/api/reports/overview/",
        "method": "GET",
        "app": "reports",
        "handler": "reportsOverview",
        "purpose": "Get reports overview",
        "auth": "Yes",
        "required": {},
        "optional": {}
      }
    ]
