        "auth": "Yes",
        "required": {
          "body": ["project_name", "project_description", "status"]
        },
        "optional": {
          "body": ["team_members", "progress", "start_date", "due_date"]
        }
      },
      {
        "path": "/api/projects/projects/",
        "method": "GET",
