        "purpose": "Django admin site routes",
        "auth": "Unknown",
        "required": {},
        "optional": {}
      },
      {
        "path": "/api/users/",
        "method": "POST",
        "app": "users",
        "handler": "signup_user",
        "purpose": "Register a new user and create an auth token",
        "auth": "No (AllowAny)",
        "required": {
          "body": ["username", "email", "password"]
        },
        "optional": {
          "body": ["first_name", "last_name", "role"]
        }
      },
      {
        "path": "/api/users/login/",
        "method": "POST",
        "app": "users",
        "handler": "user_login",
        "purpose": "Log in and return token + user payload",
        "auth": "No (AllowAny)",
        "required": {
          "body": ["username", "password"]
        },
        "optional": {}
      },
      {
        "path": "/api/users/me/",
        "method": "GET",
        "app": "users",
        "handler": "current_user",
        "purpose": "Return authenticated user profile",
        "auth": "Yes (Token or Session)",
        "required": {},
        "optional": {}
      },
      {
        "path": "/api/users/users/",
        "method": "GET",
        "app": "users",
        "handler": "getUsers",
        "purpose": "List users excluding admin",
        "auth": "Yes (Token or Session)",
        "required": {},
        "optional": {}
      },
      {
        "path": "/api/users/<int:pk>/",
