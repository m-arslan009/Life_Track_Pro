        "app": "users",
        "handler": "user_detail",
        "purpose": "Retrieve user by ID",
        "auth": "Yes (Token or Session)",
        "required": {
          "path": ["pk"]
        },
        "optional": {}
      },
      {
        "path": "/api/users/<int:pk>/",
