        "handler": "projectDetail",
        "purpose": "Update project",
        "auth": "Yes",
        "required": {
          "path": ["pk"]
        },
        "optional": {
          "body": ["any_project_fields", "team_members"]
        }
      },
      {
        "path": "/api/projects/<int:pk>/",
        "method": "DELETE",
        "app": "projects",
        "handler": "projectDetail",
        "purpose": "Delete project",
        "auth": "Yes",
        "required": {
          "path": ["pk"]
        },
        "optional": {}
      },
      {
        "path": "/api/tasks/tasks/",
